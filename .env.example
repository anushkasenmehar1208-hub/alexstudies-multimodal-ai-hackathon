# Alex Studies Track D local development template.
# Copy to .env and replace placeholders locally. Never commit .env.

# Dedicated local PostgreSQL only. Track D tests refuse non-local hosts,
# ports other than 55432, and database names other than alexstudies_hackathon.
DATABASE_URL=postgresql://alexstudies:change-me@127.0.0.1:55432/alexstudies_hackathon
DATABASE_SSL_MODE=disable
RUN_DATABASE_MIGRATIONS=true

# Local application origins.
APP_BASE_URL=http://localhost:3000
REFLEX_API_URL=http://127.0.0.1:8000
REFLEX_BACKEND_URL=http://127.0.0.1:8000
ENFORCE_HTTPS=false

# Replace with a new random local value, for example: openssl rand -base64 32
SESSION_SECRET=replace-with-a-local-random-secret

# Optional Google sign-in for the isolated host. Password authentication does
# not require these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Track D text provider. The key must remain server-side.
ALEX_DEMO_FREE_MODE=true
ALEX_TEXT_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional caption service. Direct caption strategies are attempted without it.
SUPADATA_API_KEY=

# Optional local OCR binary override. Leave empty to use macOS Vision where
# available or an installed tesseract executable.
ALEX_VISION_OCR_BIN=

# Optional local logging settings.
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Colombo
